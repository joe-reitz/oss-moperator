# mOperator environment
#
# Copy to .env.local and fill in what you need. mOperator activates integrations
# from this file: set an integration's variables and its tools appear, and the
# agent's own system prompt starts mentioning it. Leave them out and the agent
# never sees those tools, so it will not promise work it cannot do.
#
# Run `npm run agent:info` at any time to see exactly what is active.

# ─── Model (required) ────────────────────────────────────────────────────────
#
# One credential, any model, through the Vercel AI Gateway.
# https://vercel.com/docs/ai-gateway
#
# If you link this project to Vercel (`npx eve link`), a VERCEL_OIDC_TOKEN is
# pulled into .env.local automatically and you can skip the key entirely.
AI_GATEWAY_API_KEY=

# Optional: override the model. Any AI Gateway model id.
# `npx eve set --model <id>` writes it into agent/agent.ts permanently instead.
# AI_MODEL=anthropic/claude-opus-4.8

# Optional: smaller models for narrow jobs.
# MOPERATOR_ANALYST_MODEL=anthropic/claude-opus-4.8       # data-analyst subagent
# MOPERATOR_JUDGE_MODEL=anthropic/claude-haiku-4.5        # eval grading


# ─── Identity and conventions ────────────────────────────────────────────────
#
# These shape how the agent talks and what it enforces. See agent/lib/config.ts.
# BOT_NAME=mOperator
# MOPERATOR_ORG_NAME=Acme                    # so it knows whose CRM this is
# MOPERATOR_TIMEZONE=America/Los_Angeles     # for "this quarter", digests, dates
# MOPERATOR_FISCAL_YEAR_START_MONTH=1        # 1-12; 2 = February start

# Campaign naming convention, enforced by the check_campaign_name tool.
# MOPERATOR_CAMPAIGN_NAME_PATTERN=^[A-Z]{2,5}-FY\d{2}Q[1-4]-[a-z0-9-]+-[a-z0-9-]+$
# MOPERATOR_CAMPAIGN_NAME_EXAMPLE=NAM-FY26Q1-webinar-observability-launch

# Allowed UTM values, enforced by the build_tracking_url tool. Comma-separated.
# Leave sources unset to allow anything.
# MOPERATOR_UTM_MEDIUMS=email,paid-search,paid-social,organic-social,display,referral,event,webinar
# MOPERATOR_UTM_SOURCES=


# ─── Who can approve what (required for writes) ──────────────────────────────
#
# Comma-separated emails. This one list does three things:
#   1. gates the admin pages (/chat, /console, /analytics, /audience-vocab)
#   2. lets these people perform CRM writes without waiting for approval
#   3. lets them approve someone else's write
#
# An empty list means every write needs approval and nobody can grant it — safe,
# but the agent cannot change anything. Set it before you expect writes to work.
AUTHORIZED_USER_EMAILS=

# Who may approve anything that moves ad budget. Ad spend ALWAYS requires
# approval, including for the requester; this controls who can grant it.
# Defaults to AUTHORIZED_USER_EMAILS.
# GROWTH_MARKETING_APPROVERS=

# Optional: Slack user group to @mention on approval requests, e.g. S0123456789.
# SLACK_APPROVER_GROUP_ID=

# Optional: write limits. Above the threshold a bulk write needs approval even
# from an approver; above the max it is refused outright.
# MOPERATOR_BULK_APPROVAL_THRESHOLD=100
# MOPERATOR_BULK_MAX=1500
# MOPERATOR_CSV_EXPORT_ROWS=50000


# ─── Browser sign-in (required for the admin pages) ──────────────────────────
#
# People sign in with Slack at /admin/signin; their email must be on
# AUTHORIZED_USER_EMAILS. The same cookie authenticates the agent's own routes,
# so /chat needs no second login.
#
# Register the redirect URL in your Slack app:
#   {NEXT_PUBLIC_APP_URL}/api/admin/signin/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Signs the session cookie. Generate: openssl rand -hex 32
# Rotating it signs everyone out.
MOPERATOR_SESSION_SECRET=


# ─── Slack (required for the Slack bot) ──────────────────────────────────────
#
# Recommended: Vercel Connect. Run `npx eve add channel/slack` and choose
# Connect. It manages the bot token, verifies inbound requests, handles rotation,
# and supports multiple workspace installs with no Slack secret in this file.
# Set the connector UID it gives you:
# MOPERATOR_SLACK_CONNECTOR=slack/moperator
#
# Fallback: manage the credentials yourself. Point your Slack app's Event
# Subscriptions and Interactivity request URLs at:
#   https://your-app.example.com/eve/v1/slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Optional: restrict the agent to specific Slack channels. Comma-separated IDs.
# Unset means anywhere the app is installed, which is right for an internal bot.
# Set it if the app is in a Slack Connect channel with people outside your org.
# MOPERATOR_ALLOWED_SLACK_CHANNELS=

# Optional: scheduled digests. Each is a Slack channel ID. A schedule with no
# channel stays inert, so a fresh fork never posts anywhere unasked.
# MOPERATOR_CAMPAIGN_DIGEST_CHANNEL=      # Mondays, campaign activity
# MOPERATOR_AD_SPEND_DIGEST_CHANNEL=      # daily, spend anomalies
# MOPERATOR_TRIAGE_DIGEST_CHANNEL=        # Fridays, what was filed and shipped


# ─── Salesforce (optional) ───────────────────────────────────────────────────
# docs/setup-salesforce.md
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=
# For automatic token refresh on the service account:
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REFRESH_TOKEN=
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# ── Who Salesforce records as making a change ────────────────────────────────
#
# Salesforce already has a real audit trail: CreatedById, LastModifiedById,
# Field History Tracking, Setup Audit Trail. The only thing that makes it
# useless for an agent is a shared service account — then every change reads as
# "the bot did it" and answers nothing.
#
# So the default is per-user: a change is recorded under the person who asked
# for it, and if it cannot be, it does not happen. There is no silent fallback,
# because a quiet downgrade produces exactly the audit trail you think you have
# and do not.
#
#   user      (default) writes need the requester's own Salesforce identity;
#             reads use the service account, so nobody signs in to ask a question
#   user-all  reads too, so sharing rules and field-level security apply per
#             person and the agent cannot surface a record they could not open
#   service   everything as the service account. Explicit opt-out.
#
# `user` and `user-all` need SALESFORCE_CLIENT_ID/SECRET, Redis, and
# MOPERATOR_TOKEN_ENCRYPTION_KEY below. Scheduled runs cannot write under them.
SFDC_IDENTITY=user

# Per-user Salesforce OAuth (required unless SFDC_IDENTITY=service).
# Each person signs in to their own Salesforce account, so writes show them in
# CreatedById instead of a shared service user. eve drives the sign-in inline —
# in Slack it arrives as an ephemeral message, in /chat as a prompt in the
# conversation — and the turn resumes where it paused.
#
# Needs Redis and an encryption key for the stored refresh tokens. Register the
# redirect URI eve mints in your Connected App; see docs/sfdc-per-user-oauth.md.
# Generate: openssl rand -hex 32. Rotating it voids every stored grant.
MOPERATOR_TOKEN_ENCRYPTION_KEY=


# ─── HubSpot (optional) ──────────────────────────────────────────────────────
# docs/setup-hubspot.md — Private App access token
HUBSPOT_API_TOKEN=


# ─── Marketo (optional) ──────────────────────────────────────────────────────
# docs/setup-marketo.md — LaunchPoint custom service
MARKETO_CLIENT_ID=
MARKETO_CLIENT_SECRET=
MARKETO_REST_ENDPOINT=


# ─── Google Ads (optional) ───────────────────────────────────────────────────
# docs/setup-google-ads.md
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
# Optional: warn louder above this daily budget, in USD.
# MOPERATOR_AD_BUDGET_WARN_USD=500


# ─── Project tracker (optional) ──────────────────────────────────────────────
#
# Where the agent files bugs, requests, and tasks. Configure ONE — the tools
# adapt to it, including the words they use ("task" for Asana, "issue" for
# Jira, "item" for monday). docs/setup-project-tracker.md
#
# If you configure several, MOPERATOR_TRACKER picks the default and the tools
# gain a `tracker` parameter for the others.
# MOPERATOR_TRACKER=asana

# Linear
LINEAR_API_KEY=
LINEAR_TEAM_NAME=ENG

# Asana — personal access token from Settings -> Apps -> Developer apps
# ASANA_ACCESS_TOKEN=
# ASANA_WORKSPACE_ID=        # only needed if the token sees several workspaces
# ASANA_PROJECT_ID=          # default project to file into

# Jira Cloud — an API token from id.atlassian.com
# JIRA_SITE=acme             # or acme.atlassian.net
# JIRA_EMAIL=you@acme.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=MKTG      # default project to file into
# JIRA_ISSUE_TYPE=Task       # defaults to Task

# monday.com — Admin -> API
# MONDAY_API_TOKEN=
# MONDAY_BOARD_ID=           # default board to file into

# ClickUp — Settings -> Apps -> API token
# CLICKUP_API_TOKEN=
# CLICKUP_TEAM_ID=           # only needed if the token sees several workspaces
# CLICKUP_LIST_ID=           # default list to file into


# ─── GitHub (optional) ───────────────────────────────────────────────────────
# docs/setup-github.md — token needs repo read access
GITHUB_TOKEN=
GITHUB_REPO=


# ─── Knak (optional) ─────────────────────────────────────────────────────────
#
# On-brand email builder. docs/setup-knak.md
# The API key is a service credential, so generated assets are created by that
# identity rather than by whoever last signed in.
KNAK_API_KEY=

# Where generated assets land when the request does not name a campaign.
# The folder path is walked segment by segment under the brand.
# KNAK_DEFAULT_BRAND=Acme
# KNAK_FOLDER_PATH=Campaigns/Lifecycle

# Themes are the brand design system an email is generated against. Selected by
# name, because the id in a Knak UI URL is not the API id. Leave unset to use
# the brand's own default.
# KNAK_DEFAULT_THEME_NAME=Standard Email
# KNAK_NEWSLETTER_THEME_NAME=Newsletter Template
# KNAK_DEFAULT_THEME_ID=              # short-circuits the name lookup

# Asset naming. Knak cannot rename an asset after creation, so this is applied
# at generation time. Empty tokens collapse rather than leaving gaps.
# KNAK_ASSET_NAME_PATTERN={region}_{type}_{brand}_{title}_{date}_{ticket}

# Self-hosted or non-default Knak instance.
# KNAK_API_URL=https://enterprise.knak.io/api/published/v1
# KNAK_APP_URL=https://enterprise.knak.io


# ─── Luma (optional) ─────────────────────────────────────────────────────────
# API key from your Luma calendar settings. Compliance registration questions
# are attached to every event automatically; edit them in
# agent/lib/luma/client.ts.
LUMA_API_KEY=
# LUMA_DEFAULT_COVER_URL=
# Salesforce Campaign field that stores the Luma event id after creation.
# SFDC_CAMPAIGN_LUMA_EVENT_FIELD=Luma_Event_Id__c


# ─── Redis (optional, but several features need it) ──────────────────────────
#
# Used for: usage analytics behind /analytics, saved SOQL queries in /console,
# the audience vocabulary from /audience-vocab, and per-user Salesforce grants.
#
# NOT used for approvals any more — those are durable pauses in the agent
# runtime, so they survive a redeploy and never expire.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
