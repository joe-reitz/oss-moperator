# ─── AI Model (required — pick one option) ────────────────────────────────────
#
# Option A: Vercel AI Gateway (recommended)
# One key, any model. Switch providers without code changes.
# See https://vercel.com/docs/ai-gateway for setup.
AI_GATEWAY_API_KEY=          # Your Vercel AI Gateway API key
# AI_GATEWAY_URL=            # Optional: defaults to https://ai-gateway.vercel.sh
#
# Option B: Direct API key (simpler, single provider)
# ANTHROPIC_API_KEY=         # Get one at console.anthropic.com
# OPENAI_API_KEY=            # Get one at platform.openai.com
#
AI_PROVIDER=anthropic        # "anthropic" or "openai"
# AI_MODEL=                  # Optional: override model (default: claude-sonnet-4-5-20250929)

# ─── Slack Bot (required for Slack integration) ──────────────────────────────
SLACK_BOT_TOKEN=             # xoxb-your-bot-token
SLACK_BOT_USER_ID=           # The bot's Slack user ID (for thread history)
# BOT_NAME=mOperator         # Optional: customize the bot's display name

# ─── Slack signing verification (required for production) ────────────────────
# api.slack.com → Your App → Basic Information → App Credentials → Signing Secret.
# Verifies every webhook from Slack is real. Without it, anyone who finds your
# deployment URL can forge events. See docs/security.md.
SLACK_SIGNING_SECRET=

# ─── Sign in with Slack (required for admin pages) ───────────────────────────
# Gates /console, /analytics, /audience-vocab. Users sign in via Slack OAuth;
# their email must be on AUTHORIZED_USER_EMAILS below.
# api.slack.com → Your App → OAuth & Permissions → Client ID / Client Secret.
# Don't forget to register the redirect URL in your Slack app:
#   {NEXT_PUBLIC_APP_URL}/api/admin/signin/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ─── Admin session signing (required for admin pages) ────────────────────────
# Generate: openssl rand -hex 32
# Signs the admin session cookie. Rotating it logs everyone out.
MOPERATOR_SESSION_SECRET=

# ─── Authorized Users & Approvals ────────────────────────────────────────────
# Comma-separated email addresses of users who:
#   1. Can sign in to admin pages (/console, /analytics, /audience-vocab)
#   2. Can execute write operations (Salesforce/HubSpot/Marketo) without
#      triggering an approval workflow
# Other users trigger an approval workflow with Approve/Deny buttons.
AUTHORIZED_USER_EMAILS=
# Optional: Slack user group ID for @mentioning approvers (e.g., S0123456789).
# If not set, approval messages will mention "@approvers" as plain text.
# SLACK_APPROVER_GROUP_ID=

# ─── Salesforce (optional) ───────────────────────────────────────────────────
# Run OAuth flow at /api/integrations/salesforce to get tokens
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_REFRESH_TOKEN=
SALESFORCE_INSTANCE_URL=

# ─── Per-user Salesforce OAuth (optional, recommended for production) ────────
# When enabled, /moperator connect-sfdc lets users connect their own SFDC
# account so writes show their identity in CreatedById / LastModifiedById.
# Falls back to the service account above for users who haven't connected.
# See docs/sfdc-per-user-oauth.md for full setup (Connected App redirect URI,
# threat model, etc.).
SFDC_USER_OAUTH_ENABLED=false
# Generate: openssl rand -hex 32
# Encrypts each user's refresh token at rest in Redis. Required when the
# feature flag above is set to true. Rotating this voids all stored tokens.
MOPERATOR_TOKEN_ENCRYPTION_KEY=

# ─── Linear (optional) ──────────────────────────────────────────────────────
LINEAR_API_KEY=
LINEAR_TEAM_NAME=ENG         # Your team's key in Linear (e.g., ENG, MOPS)

# ─── GitHub (optional) ──────────────────────────────────────────────────────
GITHUB_TOKEN=                # Personal access token with repo read access
GITHUB_REPO=                 # owner/repo format (e.g., acme/marketing-site)

# ─── HubSpot (optional) ────────────────────────────────────────────────────
HUBSPOT_API_TOKEN=           # Private App access token

# ─── Marketo (optional) ────────────────────────────────────────────────────
MARKETO_CLIENT_ID=           # LaunchPoint custom service Client ID
MARKETO_CLIENT_SECRET=       # LaunchPoint custom service Client Secret
MARKETO_REST_ENDPOINT=       # e.g., https://123-ABC-456.mktorest.com

# ─── Luma (optional) ───────────────────────────────────────────────────────
# API key for your Luma calendar. Lets the agent create event registration
# pages with compliance questions auto-injected.
LUMA_API_KEY=
# Optional: default cover image URL for events
# LUMA_DEFAULT_COVER_URL=
# Optional: SFDC Campaign field that stores the Luma event ID after creation
# (defaults to Luma_Event_Id__c)
# SFDC_CAMPAIGN_LUMA_EVENT_FIELD=Luma_Event_Id__c
# Optional: auto-grant Luma host access to event requesters whose Slack
# email ends with this domain (e.g. "@yourcompany.com"). Leave unset to
# never auto-grant.
# LUMA_AUTO_HOST_EMAIL_DOMAIN=

# ─── Google Ads (optional) ─────────────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=         # From Google Ads API Center (MCC account)
GOOGLE_ADS_CUSTOMER_ID=             # 10-digit ad account ID (no dashes)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=       # MCC account ID (no dashes), if using manager account
GOOGLE_ADS_ACCESS_TOKEN=            # Filled after OAuth flow
GOOGLE_ADS_REFRESH_TOKEN=           # Filled after OAuth flow
# Optional: restrict who can approve ad spend operations
GROWTH_MARKETING_APPROVERS=         # Comma-separated emails (e.g., cody@company.com)

# ─── Redis (required for approvals, also used for slash command state) ───────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
